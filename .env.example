NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx
NGINX_ENVSUBST_FILTER=^DOMAIN$
DOMAIN=24tunl.ru (or your domain)

POSTGRES_USER="your_text"
POSTGRES_PASSWORD="your_text"
POSTGRES_DB="your_text"

SECRET_KEY="your_text"
DB_HOST="your_text"
DB_PORT="your_text"
TG_BOT_TOKEN="your_text"
NTB_ADMIN_TOKEN="your_text (for api access)"
FIRST_SUPERUSER_USERNAME="your_text"
FIRST_SUPERUSER_PASSWORD="your_text"
SESSION_SECRET_KEY="your_text (random string)"
